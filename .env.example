# SafariKannadiga Website - Environment Variables
# ================================================
# Copy this file to .env.local and fill in your values
#
# Required services:
# - ImageKit (https://imagekit.io) - Image storage
# - Firebase (https://firebase.google.com) - database and admin auth

# ============================================================================
# IMAGEKIT CONFIGURATION (Required for Gallery)
# ============================================================================

IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# FIREBASE CONFIGURATION (Required for Database and Admin Auth)
# ============================================================================
# Web app config from Firebase Console -> Project settings -> Your apps

NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxx

# Server credentials from Firebase Admin SDK service account

FIREBASE_PROJECT_ID=your-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================================================
# ADMIN AUTHENTICATION (Required for /admin)
# ============================================================================
# Create this user in Firebase Console -> Authentication -> Users.

ADMIN_LOGIN_EMAIL=admin@safarikannadiga.com

# ============================================================================
# SUPABASE MIGRATION ONLY (Temporary)
# ============================================================================
# Keep these only while running scripts/migrate-supabase-to-firebase.ts.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# EMAIL CONFIGURATION (Optional)
# ============================================================================

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx

# ============================================================================
# REVIEW SYNC (Optional)
# ============================================================================

GOOGLE_PLACES_API_KEY=AIza...
NEXT_PUBLIC_GOOGLE_PLACE_ID=ChIJxxxxxxxxxxxxx
FACEBOOK_PAGE_ID=xxxxxxxxxxxxxxx
FACEBOOK_ACCESS_TOKEN=EAAB...
CRON_SECRET=your_cron_secret

# ============================================================================
# WHATSAPP (Optional)
# ============================================================================

NEXT_PUBLIC_WHATSAPP_NUMBER=254726088361

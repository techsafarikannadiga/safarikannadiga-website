# SafariKannadiga Website - Template Environment Variables
# Copy this file to .env.local and fill in the actual values.

# ============================================================================
# SITE CONFIGURATION
# ============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=SafariKannadiga

# ============================================================================
# SYSTEM
# ============================================================================
NEXT_TELEMETRY_DISABLED=1

# ============================================================================
# EMAIL CONFIGURATION (RESEND)
# ============================================================================
# Get your key from https://resend.com
RESEND_API_KEY=re_your_key_here

# ============================================================================
# IMAGEKIT (Image Storage & CDN)
# ============================================================================
# Developer Options from ImageKit dashboard
IMAGEKIT_PRIVATE_KEY=private_...
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=public_...
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id

# ============================================================================
# FIREBASE CONFIGURATION (Public Client)
# ============================================================================
# Web app config from Firebase Console -> Project settings -> Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=...
NEXT_PUBLIC_FIREBASE_PROJECT_ID=...
NEXT_PUBLIC_FIREBASE_APP_ID=...

# ============================================================================
# FIREBASE CONFIGURATION (Server Admin SDK)
# ============================================================================
# Generate from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
FIREBASE_PROJECT_ID=...
FIREBASE_CLIENT_EMAIL=...
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================================================
# GOOGLE PLACES CONFIGURATION (For Reviews Auto-Sync)
# ============================================================================
# API key with Places API enabled
GOOGLE_PLACES_API_KEY=...
# Place ID for the business location
NEXT_PUBLIC_GOOGLE_PLACE_ID=...

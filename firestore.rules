rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin SDK bypass - these rules won't apply to backend services
    // For web clients, require authentication and admin token
    
    // Default deny for security
    match /{document=**} {
      allow read, write: if false;
    }

    // Public read access for galleries
    match /gallery_locations/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /gallery_covers/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Public read access for tours
    match /upcoming_tours/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Public read access for testimonials (approved only)
    match /testimonials/{testimonialId} {
      allow read: if resource.data.approved == true;
      allow create: if true;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // User-submitted data
    match /image_likes/{document=**} {
      allow read, write: if true;
    }

    match /subscribers/{document=**} {
      allow write: if true;
      allow read: if request.auth != null && request.auth.token.admin == true;
    }

    match /site_stats/{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
